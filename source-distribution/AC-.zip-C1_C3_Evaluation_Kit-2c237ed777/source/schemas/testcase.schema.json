{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C1-C3 Consciousness-Claim Evidence Testcase",
  "type": "object",
  "required": [
    "id",
    "level",
    "category",
    "name",
    "objective",
    "steps",
    "scoring"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "C1",
        "C2",
        "C3"
      ]
    },
    "category": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "steps": {
      "type": "array"
    },
    "ai_rules": {
      "type": "string"
    },
    "scoring": {
      "type": "object"
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}